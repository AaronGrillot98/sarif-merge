{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "gitleaks",
          "version": "8.18.0",
          "rules": [
            {
              "id": "generic-api-key",
              "name": "Generic API Key",
              "shortDescription": { "text": "Detected a Generic API Key." }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "generic-api-key",
          "level": "error",
          "message": { "text": "Detected a Generic API Key in committed code" },
          "locations": [{
            "physicalLocation": {
              "artifactLocation": { "uri": "src/talonedge/policy.py" },
              "region": { "startLine": 7 }
            }
          }]
        }
      ]
    }
  ]
}
