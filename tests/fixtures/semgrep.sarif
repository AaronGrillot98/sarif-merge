{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Semgrep",
          "version": "1.50.0",
          "rules": [
            {
              "id": "python.lang.security.audit.dangerous-subprocess-use",
              "name": "dangerous-subprocess-use",
              "shortDescription": { "text": "Found subprocess function call with shell=True" },
              "properties": { "security-severity": "8.5", "cwe": "CWE-78" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "python.lang.security.audit.dangerous-subprocess-use",
          "level": "error",
          "message": { "text": "Found subprocess function call with shell=True. This is dangerous because shell=True allows shell injection." },
          "locations": [{
            "physicalLocation": {
              "artifactLocation": { "uri": "src/talonedge/cli.py" },
              "region": { "startLine": 43 }
            }
          }],
          "properties": { "security-severity": "8.5" }
        }
      ]
    }
  ]
}
